{
  "id": "zammad-spsync",
  "name": "Zammad SPsync",
  "version": "0.1.8",
  "description": "Sync Zammad tickets (out of waiting + newly assigned) to Super Productivity",
  "manifestVersion": 1,
  "minSupVersion": "14.0.2",
  "type": "issueProvider",
