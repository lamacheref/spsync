    "issueProviderKey": "ZAMMAD",
    "defaultAutoAddToBacklog": false
  },
  "permissions": [],
  "hooks": [],
  "iFrame": true,
  "icon": "icon.svg",
  "i18n": {
    "languages": [
      "en",
      "fr"
    ]
  }
}
