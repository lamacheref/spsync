# .cred.example — copy to .cred and fill with real values (never committed)
# This file is ignored via .gitignore (.cred)
# Placeholders used in docs (*.md) map to these keys.

ZAMMAD_URL=https://zammad.example.com
ZAMMAD_TOKEN=<your-zammad-token>
ZAMMAD_USER=<your-login-or-email> # e.g. nehwonlm@example.com or login
ZAMMAD_USER_ID=3 # legacy numeric, prefer ZAMMAD_USER
ZAMMAD_TIMEOUT=30
ZAMMAD_INCLUDE_UPDATED=true
ZAMMAD_POLL_INTERVAL=90000
ZAMMAD_AUTO_ADD_BACKLOG=false

SP_URL=http://127.0.0.1:3876
SP_TOKEN=<your-super-productivity-local-rest-api-token>

GITEA_URL=https://gitea.example.com/<user>/spsync.git
GITHUB_URL=git@github.com:lamacheref/spsync.git
ZAMMAD_USER_EMAIL=<your-email@example.com>
